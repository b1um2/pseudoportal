<header class="topbar">
  <div class="brand">AyADVI <span>pseudoportal</span></div>
  <nav class="nav">
    <% if (user && user.role === 'student') { %>
      <a href="/student">Overview</a>
    <% } %>
    <% if (user && user.role === 'advisor') { %>
      <a href="/advisor">Queue</a>
      <a href="/advisor/meetings">Meetings</a>
      <a href="/advisor/messages">Messages</a>
      <a href="/advisor/audit">Audit</a>
      <a href="/students/new">New student</a>
    <% } %>
    <% if (user && user.role === 'professor') { %>
      <a href="/professor">Sections</a>
      <a href="/students/new">New student</a>
    <% } %>
  </nav>
  <div class="who">
    <span><%= user.display_name %> · <%= user.role %></span>
    <form method="post" action="/logout"><button class="link">Log out</button></form>
  </div>
</header>
<main class="container">
