<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<div class="page-head"><h1>Audit log</h1><p class="muted">Every login, submission, decision, and failure.</p></div>

<section class="card">
  <table>
    <thead><tr><th>When</th><th>Actor</th><th>Action</th><th>Object</th><th>Details</th></tr></thead>
    <tbody id="live-audit" data-live>
      <% rows.forEach(function (r) { %>
        <tr>
          <td><%= fmtDateTime(r.created_at) %></td>
          <td><%= r.actor_name || r.actor_id || 'system' %></td>
          <td><%= r.action %></td>
          <td><%= r.object_type %> #<%= r.object_id %></td>
          <td class="muted"><%= JSON.stringify(r.details) %></td>
        </tr>
      <% }) %>
      <% if (!rows.length) { %><tr><td colspan="5" class="muted">No audit rows yet.</td></tr><% } %>
    </tbody>
  </table>
</section>

<%- include('../partials/footer') %>
