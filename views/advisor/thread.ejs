<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<div class="page-head">
  <div>
    <h1><%= student.student_name %></h1>
    <p class="muted"><%= student.student_no %> · <%= student.student_email || 'no email' %></p>
  </div>
  <a class="btn" href="/advisor/messages">All messages</a>
</div>

<section class="card">
  <h2>Conversation</h2>
  <p class="muted">Showing the latest 5 messages.</p>
  <div id="live-thread" data-live>
    <% if (!messages.length) { %><p class="muted">No messages yet. Start the conversation below.</p><% } %>
    <% messages.forEach(function (m) { %>
      <div class="message <%= m.sender_role %>">
        <div class="message-meta"><%= m.sender_role %> · <%= fmtDateTime(m.created_at) %></div>
        <div><%= m.body %></div>
      </div>
    <% }) %>
  </div>

  <form method="post" action="/advisor/messages/<%= student.id %>" class="stack">
    <label>Reply
      <textarea name="body" rows="3" placeholder="Write a reply to the student" required></textarea>
    </label>
    <button class="btn primary" type="submit">Send reply</button>
  </form>
</section>

<%- include('../partials/footer') %>
