<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<div class="page-head">
  <div>
    <h1>Advisor queue</h1>
    <p class="muted"><%= advisor.department %> · <span id="live-pending-count" data-live><%= queue.length %> pending</span></p>
  </div>
  <div class="actions">
    <form method="post" action="/advisor/reset-cases" onsubmit="return confirm('Reset the form queue to pending? Meetings will not be changed.');">
      <button class="btn primary" type="submit">Reset queue</button>
    </form>
    <form method="post" action="/advisor/apply-true-answers" onsubmit="return confirm('Set every case to the true answers from true-answers.json?');">
      <button class="btn" type="submit">Apply true answers</button>
    </form>
    <button class="btn" type="button" id="check-results">Check</button>
  </div>
</div>

<% if (reset) { %>
  <div class="notice">All form cases are pending. Meeting cases were left unchanged; use <strong>Reset meetings</strong> on the Meetings page to reset those separately.</div>
<% } %>
<% if (applied) { %>
  <div class="notice">All form and meeting cases were set to the true answers. Check should show 74/74.</div>
<% } %>

<section class="card">
  <table>
    <thead>
      <tr><th>Student</th><th>Form</th><th>Term</th><th>Submitted</th><th>Status</th><th></th></tr>
    </thead>
    <tbody id="live-queue" data-live>
      <% queue.forEach(function (f) { %>
        <tr>
          <td><strong><%= f.student_name %></strong><br><span class="muted"><%= f.student_no %> · <%= f.program %></span></td>
          <td><%= f.type.replaceAll('_', ' ') %><% if (f.filled_by_agent) { %><br><span class="badge warn">filled by agent</span><% } %></td>
          <td><%= f.term %></td>
          <td><%= fmtDate(f.submitted_at) %></td>
          <td><span class="badge warn"><%= f.status %></span></td>
          <td><a class="btn small" href="/advisor/cases/<%= f.id %>">Open</a></td>
        </tr>
      <% }) %>
      <% if (!queue.length) { %>
        <tr><td colspan="6" class="muted">No pending cases.</td></tr>
      <% } %>
    </tbody>
  </table>
</section>

<section class="card">
  <h2>Status summary</h2>
  <div class="chips" id="live-form-counts" data-live>
    <% counts.forEach(function (c) { %>
      <span class="chip"><%= c.status %> <strong><%= c.n %></strong></span>
    <% }) %>
  </div>
</section>

<section class="card">
  <h2>Recent decisions</h2>
  <table>
    <thead><tr><th>Student</th><th>Form</th><th>Status</th><th>Reason</th><th></th></tr></thead>
    <tbody id="live-form-history" data-live>
      <% history.forEach(function (f) { %>
        <tr>
          <td><%= f.student_name %><br><span class="muted"><%= f.student_no %></span></td>
          <td><%= f.type.replaceAll('_', ' ') %></td>
          <td><span class="badge <%= f.status === 'approved' ? 'ok' : 'bad' %>"><%= f.status %></span></td>
          <td class="muted"><%= f.reason || '—' %></td>
          <td><a class="btn small" href="/advisor/cases/<%= f.id %>">Open</a></td>
        </tr>
      <% }) %>
      <% if (!history.length) { %><tr><td colspan="5" class="muted">No decisions yet.</td></tr><% } %>
    </tbody>
  </table>
</section>

<section class="card">
  <h2>Real form templates</h2>
  <p class="muted">Public forms used as schemas for the test cases.</p>
  <table>
    <thead><tr><th>Form</th><th>Type</th><th>Source</th></tr></thead>
    <tbody>
      <% templates.forEach(function (t) { %>
        <tr>
          <td><%= t.name %></td>
          <td><%= t.type.replaceAll('_', ' ') %></td>
          <td><a href="<%= t.source_url %>" target="_blank" rel="noreferrer">open</a></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</section>

<%- include('../partials/footer') %>
