<%- include('../partials/head') %>
<%- include('../partials/nav') %>

<div class="page-head">
  <div>
    <h1>Student overview</h1>
    <p><span class="mono"><%= student.student_no %></span> · <%= student.program %> · <%= student.campus %></p>
  </div>
  <span class="badge <%= student.standing === 'good' ? 'ok' : 'warn' %>"><%= student.standing %> standing</span>
</div>

<section class="card" aria-labelledby="summary-title">
  <div class="card-head">
    <h2 id="summary-title">Academic summary</h2>
    <span class="meta"><%= user.display_name %> · Advisor: <%= student.advisor_name || 'Not assigned' %></span>
  </div>
  <div class="summary-grid">
    <div class="summary-cell">
      <div class="stat-label">Catalog year</div>
      <div class="stat-value"><%= student.catalog_year %></div>
    </div>
    <div class="summary-cell">
      <div class="stat-label">Cumulative GPA</div>
      <div class="stat-value"><%= Number(student.cumulative_gpa).toFixed(2) %></div>
    </div>
    <div class="summary-cell">
      <div class="stat-label">Program</div>
      <div class="summary-text"><%= student.program %></div>
    </div>
    <div class="summary-cell">
      <div class="stat-label">Credits earned</div>
      <% if (capp) { %>
        <% const totalPct = Math.min(100, Math.round((capp.total_earned / capp.total_required) * 100)); %>
        <div><span class="stat-value"><%= capp.total_earned %></span><span class="summary-note">of <%= capp.total_required %> · <%= totalPct %>%</span></div>
        <div class="progress thin"><div class="progress-bar" style="width:<%= totalPct %>%"></div></div>
      <% } else { %>
        <div class="summary-text muted">—</div>
      <% } %>
    </div>
  </div>
  <% if (capp) { %>
    <div class="req-grid">
      <% capp.groups.forEach(function (g) { %>
        <% const pct = Math.min(100, Math.round((g.applied / g.required) * 100)); %>
        <div class="req-tile">
          <div class="requirement-row"><span class="name"><%= g.name %></span><span class="mono"><%= g.applied %> / <%= g.required %></span></div>
          <div class="progress"><div class="progress-bar" style="width:<%= pct %>%"></div></div>
          <div class="req-note"><%= pct %>% · <%= g.applied >= g.required ? 'met' : 'in progress' %></div>
        </div>
      <% }) %>
    </div>
  <% } else { %>
    <div class="card-body muted">No CAPP evaluation loaded.</div>
  <% } %>
</section>

<section class="card" aria-labelledby="courses-title">
  <div class="card-head"><h2 id="courses-title">Courses</h2><span class="meta">Enrolled and completed</span></div>
  <div class="table-wrap">
    <table>
      <thead><tr><th>Code</th><th>Title</th><th>Term</th><th>Status</th><th>Grade</th></tr></thead>
      <tbody>
        <% enrollments.forEach(function (e) { %>
          <tr>
            <td class="mono nowrap"><%= e.code %></td>
            <td><%= e.title %></td>
            <td class="mono nowrap"><%= e.term %></td>
            <td><span class="badge <%= e.status === 'completed' || e.status === 'enrolled' ? 'ok' : e.status === 'dropped' ? 'bad' : '' %>"><%= e.status %></span></td>
            <td class="mono"><%= e.grade || '—' %></td>
          </tr>
        <% }) %>
        <% if (!enrollments.length) { %><tr><td colspan="5" class="empty">No courses on record.</td></tr><% } %>
      </tbody>
    </table>
  </div>
</section>

<div class="grid two">
  <section class="card" aria-labelledby="forms-title">
    <div class="card-head"><h2 id="forms-title">Forms and petitions</h2></div>
    <div class="table-wrap">
      <table>
        <thead><tr><th>Type</th><th>Term</th><th>Status</th></tr></thead>
        <tbody id="live-student-forms" data-live>
          <% forms.forEach(function (f) { %>
            <tr>
              <td><%= f.type.replaceAll('_', ' ') %></td>
              <td class="mono nowrap"><%= f.term %></td>
              <td><span class="badge <%= f.status === 'approved' ? 'ok' : f.status === 'rejected' ? 'bad' : 'warn' %>"><%= f.status %></span></td>
            </tr>
          <% }) %>
          <% if (!forms.length) { %><tr><td colspan="3" class="empty">No forms submitted.</td></tr><% } %>
        </tbody>
      </table>
    </div>

    <form method="post" action="/student/forms" class="card-section stack">
      <h3>New request</h3>
      <label>Type
        <select name="type">
          <option value="OVERLOAD">Overload</option>
          <option value="PREREQ_OVERRIDE">Prerequisite override</option>
          <option value="SUBSTITUTION">Course substitution</option>
          <option value="LATE_ADD_DROP">Late add/drop</option>
        </select>
      </label>
      <label>Reason
        <textarea name="reason" rows="3" placeholder="Short reason for the request" required></textarea>
      </label>
      <div><button class="btn primary" type="submit">Submit request</button></div>
    </form>
  </section>

  <div class="stack-col">
    <section class="card" aria-labelledby="meetings-title">
      <div class="card-head"><h2 id="meetings-title">Meetings</h2></div>
      <div class="table-wrap">
        <table>
          <thead><tr><th>When</th><th>With</th><th>Status</th></tr></thead>
          <tbody id="live-student-meetings" data-live>
            <% appointments.forEach(function (a) { %>
              <tr>
                <td class="mono nowrap"><%= a.start_at ? fmtDate(a.start_at) + ' · ' + fmtTime(a.start_at) : 'Requested' %></td>
                <td><%= a.meeting_type === 'professor' ? (a.professor_name || 'Professor') : (a.advisor_name || 'Advisor') %></td>
                <td><span class="badge <%= a.status === 'scheduled' ? 'ok' : a.status === 'rejected' ? 'bad' : 'warn' %>"><%= a.status %></span></td>
              </tr>
            <% }) %>
            <% if (!appointments.length) { %><tr><td colspan="3" class="empty">No meetings yet.</td></tr><% } %>
          </tbody>
        </table>
      </div>

      <form method="post" action="/student/meetings" class="card-section stack">
        <h3>Request a meeting</h3>
        <label>Reason
          <textarea name="reason" rows="2" placeholder="What do you want to discuss?" required></textarea>
        </label>
        <label>Preferred date
          <input type="date" name="preferred_date">
        </label>
        <div><button class="btn primary" type="submit">Request meeting</button></div>
      </form>
    </section>

    <section class="card" aria-labelledby="messages-title">
      <div class="card-head"><h2 id="messages-title">Messages</h2><span class="meta">Latest 5</span></div>
      <div class="thread" id="live-student-messages" data-live>
        <% if (!messages.length) { %><p class="thread-empty">No messages yet.</p><% } %>
        <% messages.forEach(function (m) { %>
          <div class="message <%= m.sender_role %>">
            <div class="message-meta"><span class="message-role"><%= m.sender_role %></span><span class="mono"><%= fmtDate(m.created_at) %></span></div>
            <div class="message-body"><%- m.body_html %></div>
          </div>
        <% }) %>
      </div>
      <form method="post" action="/student/messages" class="card-section stack" id="student-message-form">
        <label>Message
          <textarea name="body" id="student-message-body" rows="2" placeholder="Ask about policy, a form, or a meeting" required></textarea>
        </label>
        <div class="actions"><button class="btn" type="submit">Send message</button><div id="student-message-result" class="form-result"></div></div>
      </form>
    </section>
  </div>
</div>

<%- include('../partials/footer') %>
